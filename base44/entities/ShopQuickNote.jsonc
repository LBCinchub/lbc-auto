{
  "name": "ShopQuickNote",
  "type": "object",
  "properties": {
    "shop_owner_email": {
      "type": "string",
      "format": "email",
      "description": "Shop owner email \u2014 tenant scope key for cross-tenant isolation. Stamped on create from the authenticated session."
    },
    "text": {
      "type": "string",
      "description": "The custom quick note text shown as a one-tap chip in the Quick Notes editor."
    }
  },
  "required": [
    "shop_owner_email",
    "text"
  ],
  "rls": {
    "create": {
      "data.shop_owner_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.shop_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.shop_owner_email": "{{user.email}}"
    },
    "delete": {
      "data.shop_owner_email": "{{user.email}}"
    }
  }
}
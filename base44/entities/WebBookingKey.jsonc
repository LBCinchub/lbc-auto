{
  "name": "WebBookingKey",
  "type": "object",
  "properties": {
    "shop_owner_email": {
      "type": "string",
      "format": "email",
      "description": "Shop owner email \u2014 tenant identifier for this booking key"
    },
    "shop_name": {
      "type": "string",
      "description": "Shop display name"
    },
    "api_key": {
      "type": "string",
      "description": "Unique tenant-scoped API key issued to this shop's website"
    },
    "website_domain": {
      "type": "string",
      "description": "Shop website domain (e.g. hajwheels.com)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this key can accept bookings"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the key was issued"
    },
    "recent_booking_times": {
      "type": "array",
      "description": "ISO timestamps of recent bookings \u2014 used for per-shop rate limiting",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "shop_owner_email",
    "shop_name",
    "api_key",
    "created_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.shop_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
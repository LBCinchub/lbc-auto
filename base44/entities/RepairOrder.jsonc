{
  "name": "RepairOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Auto-generated order number"
    },
    "estimate_id": {
      "type": "string",
      "description": "Linked estimate ID (if created from an estimate)"
    },
    "customer_id": {
      "type": "string",
      "description": "Customer ID"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name for display"
    },
    "vehicle_id": {
      "type": "string",
      "description": "Vehicle ID"
    },
    "vehicle_info": {
      "type": "string",
      "description": "Vehicle year make model for display"
    },
    "mechanic_id": {
      "type": "string",
      "description": "Assigned mechanic ID"
    },
    "mechanic_name": {
      "type": "string",
      "description": "Mechanic name for display"
    },
    "description": {
      "type": "string",
      "description": "Job description"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "in_progress",
        "waiting_for_parts",
        "completed",
        "delivered"
      ],
      "default": "waiting",
      "description": "Repair status"
    },
    "labor_hours": {
      "type": "number",
      "description": "Total labor hours"
    },
    "labor_cost": {
      "type": "number",
      "description": "Total labor cost"
    },
    "labor_items": {
      "type": "array",
      "description": "Itemized labor entries",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Labor task name (the line item NAME)"
          },
          "details": {
            "type": "string",
            "description": "Per-line item description/details (the DESCRIPTION column)"
          },
          "hours": {
            "type": "number"
          },
          "rate": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "taxable": {
            "type": "boolean",
            "description": "Explicit false = tax-exempt line; missing = taxable"
          }
        }
      }
    },
    "parts_used": {
      "type": "array",
      "description": "Parts used in repair",
      "items": {
        "type": "object",
        "properties": {
          "part_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "details": {
            "type": "string",
            "description": "Per-line item description/details (the DESCRIPTION column)"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "taxable": {
            "type": "boolean",
            "description": "Explicit false = tax-exempt line; missing = taxable"
          }
        }
      }
    },
    "parts_ordered": {
      "type": "array",
      "description": "Parts ordered but not yet received",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "supplier": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "ordered",
              "received",
              "cancelled"
            ]
          },
          "order_date": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "parts_cost": {
      "type": "number",
      "description": "Total parts cost"
    },
    "total_cost": {
      "type": "number",
      "description": "Total repair cost"
    },
    "custom_total": {
      "type": "boolean",
      "description": "True when total_cost is a manually fixed amount rather than the calculated total"
    },
    "tax_rate": {
      "type": "number",
      "description": "Tax rate percentage saved on this document (explicit 0 allowed)"
    },
    "tax_applies_to": {
      "type": "string",
      "enum": [
        "both",
        "labor",
        "parts",
        "none"
      ],
      "description": "Which totals tax applies to; none = No Tax"
    },
    "apply_tax": {
      "type": "boolean",
      "description": "Legacy tax toggle; false means No Tax"
    },
    "tax_amount": {
      "type": "number",
      "description": "Tax amount saved with this document"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "none",
        "fixed",
        "percentage"
      ],
      "description": "Discount type"
    },
    "discount_value": {
      "type": "number",
      "description": "Discount value: dollars (fixed) or percent (percentage), applied to the pre-tax subtotal"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "photos": {
      "type": "array",
      "description": "Uploaded photos",
      "items": {
        "type": "string"
      }
    },
    "estimated_completion": {
      "type": "string",
      "format": "date",
      "description": "Estimated completion date"
    },
    "customer_signature": {
      "type": "string",
      "description": "Base64 PNG data URL of the customer signature"
    },
    "customer_signature_name": {
      "type": "string",
      "description": "Name of the person who signed"
    },
    "customer_signature_date": {
      "type": "string",
      "description": "ISO timestamp when the customer signed"
    },
    "history": {
      "type": "array",
      "description": "Repair order history log",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "changes": {
            "type": "object"
          }
        }
      }
    },
    "linked_invoice_id": {
      "type": "string",
      "description": "ID of the invoice created from this repair order"
    },
    "linked_invoice_number": {
      "type": "string",
      "description": "Invoice number of the linked invoice"
    },
    "ghost_items": {
      "type": "array",
      "description": "Remaining/ghost line items from a Ghost Mode split (split/phased billing)",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "part or labor"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "taxable": {
            "type": "boolean"
          }
        }
      }
    },
    "ghost_status": {
      "type": "string",
      "enum": [
        "none",
        "active",
        "converted"
      ],
      "default": "none",
      "description": "Ghost Mode state: none (no split), active (ghost exists), converted (ghost was converted to a new document)"
    },
    "ghost_converted_to": {
      "type": "string",
      "description": "ID of the new document created from this ghost"
    },
    "ghost_converted_type": {
      "type": "string",
      "description": "Invoice or RepairOrder"
    },
    "ghost_converted_number": {
      "type": "string",
      "description": "Number of the converted document"
    },
    "ghost_notes": {
      "type": "string",
      "description": "Editable 'What's Next' explanation shown on the ghost section"
    },
    "ghost_total": {
      "type": "number",
      "description": "Calculated total of remaining (ghost) items including tax"
    },
    "ghost_source_id": {
      "type": "string",
      "description": "ID of the original document this was created from (via ghost conversion)"
    },
    "ghost_source_type": {
      "type": "string",
      "description": "Estimate, Invoice, or RepairOrder \u2014 the origin document type"
    },
    "ghost_source_number": {
      "type": "string",
      "description": "Number of the origin document (e.g. EST-XXX, INV-XXX, RO-XXX)"
    }
  },
  "required": [
    "customer_id",
    "vehicle_id",
    "description"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
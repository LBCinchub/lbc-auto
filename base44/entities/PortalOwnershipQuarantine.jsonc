{
  "name": "PortalOwnershipQuarantine",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "no_authoritative_tenant_evidence",
        "conflicting_tenant_evidence",
        "test_or_anonymous_record",
        "manual_security_hold"
      ]
    },
    "evidence_summary": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_admin": {
      "type": "string",
      "format": "email"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "review_notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "customer_id",
    "reason",
    "created_at",
    "created_by_admin"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "portal_security_service"
      }
    },
    "create": {
      "user_condition": {
        "role": "portal_security_service"
      }
    },
    "update": {
      "user_condition": {
        "role": "portal_security_service"
      }
    },
    "delete": {
      "user_condition": {
        "role": "portal_security_service"
      }
    }
  }
}
{
  "name": "Mechanic",
  "type": "object",
  "properties": {
    "shop_owner_email": {
      "type": "string",
      "format": "email",
      "description": "Shop owner email \u2014 tenant scope key for cross-tenant isolation. Stamped on create from the authenticated session."
    },
    "name": {
      "type": "string",
      "description": "Mechanic full name"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "specialty": {
      "type": "string",
      "description": "Specialization area"
    },
    "pay_type": {
      "type": "string",
      "enum": [
        "hourly",
        "daily"
      ],
      "default": "hourly",
      "description": "Pay rate type"
    },
    "hourly_rate": {
      "type": "number",
      "description": "Hourly labor rate in dollars"
    },
    "daily_rate": {
      "type": "number",
      "description": "Daily labor rate in dollars"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "busy",
        "off_duty"
      ],
      "default": "available",
      "description": "Current availability status"
    },
    "pin": {
      "type": "string",
      "description": "4-digit PIN for tablet login"
    },
    "role": {
      "type": "string",
      "enum": [
        "mechanic",
        "office_staff"
      ],
      "default": "mechanic",
      "description": "mechanic = shop-floor tech assigned to repair jobs. office_staff = front-desk/admin helper who can add customers & vehicles from their phone but has no job assignments."
    }
  },
  "required": [
    "name",
    "hourly_rate"
  ],
  "rls": {
    "create": {
      "data.shop_owner_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.shop_owner_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.shop_owner_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.shop_owner_email": "{{user.email}}"
        }
      ]
    }
  }
}
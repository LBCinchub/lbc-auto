{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "shop_owner_email": {
      "type": "string",
      "format": "email",
      "description": "Shop owner email \u2014 tenant scope key for cross-tenant isolation. Stamped on create from the authenticated session."
    },
    "mechanic_id": {
      "type": "string",
      "description": "Linked mechanic ID"
    },
    "mechanic_name": {
      "type": "string",
      "description": "Mechanic name for display"
    },
    "clock_in": {
      "type": "string",
      "description": "Clock-in timestamp (ISO)"
    },
    "clock_out": {
      "type": "string",
      "description": "Clock-out timestamp (ISO)"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Total minutes worked"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Work date"
    }
  },
  "required": [
    "mechanic_id",
    "clock_in",
    "date"
  ],
  "rls": {
    "create": {
      "data.shop_owner_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.shop_owner_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.shop_owner_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.shop_owner_email": "{{user.email}}"
        }
      ]
    }
  }
}
{
  "name": "CustomerSecurityEvent",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "login_success",
        "login_failed",
        "lockout",
        "session_issued",
        "session_revoked",
        "activation_code_issued",
        "activation_code_used",
        "passcode_created",
        "passcode_changed",
        "estimate_decision",
        "message_sent",
        "contact_updated",
        "authorization_denied"
      ]
    },
    "customer_id": {
      "type": "string",
      "description": "Optional customer identifier"
    },
    "shop_owner_email": {
      "type": "string",
      "format": "email",
      "description": "Normalized lowercase tenant email"
    },
    "session_id": {
      "type": "string",
      "description": "Optional opaque session identifier, never the token"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "ip": {
      "type": "string",
      "description": "Optional request IP"
    },
    "user_agent": {
      "type": "string",
      "description": "Optional request user agent"
    },
    "metadata": {
      "type": "object",
      "description": "Non-secret audit details only"
    }
  },
  "required": [
    "event_type",
    "shop_owner_email",
    "created_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "portal_security_service"
      }
    },
    "create": {
      "user_condition": {
        "role": "portal_security_service"
      }
    },
    "update": {
      "user_condition": {
        "role": "portal_security_service"
      }
    },
    "delete": {
      "user_condition": {
        "role": "portal_security_service"
      }
    }
  }
}
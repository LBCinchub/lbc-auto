{
  "name": "Estimate",
  "type": "object",
  "properties": {
    "estimate_number": {
      "type": "string",
      "description": "Auto-generated estimate number"
    },
    "customer_id": {
      "type": "string",
      "description": "Customer ID"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name for display"
    },
    "vehicle_id": {
      "type": "string",
      "description": "Linked vehicle ID"
    },
    "vehicle_info": {
      "type": "string",
      "description": "Vehicle year make model for display"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "approved",
        "declined",
        "expired",
        "invoiced",
        "cancelled"
      ],
      "default": "draft",
      "description": "Estimate status"
    },
    "auth_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "declined"
      ],
      "default": "none",
      "description": "Customer authorization state"
    },
    "customer_decision": {
      "type": "string",
      "enum": [
        "approved",
        "declined"
      ],
      "description": "Authenticated customer decision"
    },
    "customer_decision_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server timestamp of customer decision"
    },
    "customer_decision_name": {
      "type": "string",
      "description": "Customer-confirmed signer name"
    },
    "customer_decision_note": {
      "type": "string",
      "description": "Customer-provided decision note"
    },
    "customer_decision_reference": {
      "type": "string",
      "description": "Private idempotent decision reference"
    },
    "linked_repair_order_id": {
      "type": "string",
      "description": "ID of Repair Order created from this estimate"
    },
    "linked_repair_order_number": {
      "type": "string",
      "description": "Repair Order number created from this estimate"
    },
    "linked_invoice_id": {
      "type": "string",
      "description": "ID of the invoice created from this estimate"
    },
    "linked_invoice_number": {
      "type": "string",
      "description": "Invoice number of the linked invoice"
    },
    "amount_paid": {
      "type": "number",
      "description": "Total amount paid against this estimate",
      "default": 0
    },
    "payment_history": {
      "type": "array",
      "description": "Record of payments associated with this estimate",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "method": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "service_reason": {
      "type": "string",
      "description": "Reason for visit or customer concern"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "labor_items": {
      "type": "array",
      "description": "Labor line items",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Labor task name (the line item NAME)"
          },
          "details": {
            "type": "string",
            "description": "Per-line item description/details (the DESCRIPTION column)"
          },
          "hours": {
            "type": "number"
          },
          "rate": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "parts_items": {
      "type": "array",
      "description": "Parts line items",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "details": {
            "type": "string",
            "description": "Per-line item description/details (the DESCRIPTION column)"
          },
          "part_number": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "labor_total": {
      "type": "number",
      "description": "Total labor cost"
    },
    "parts_total": {
      "type": "number",
      "description": "Total parts cost"
    },
    "tax_rate": {
      "type": "number",
      "description": "Tax rate percentage",
      "default": 0
    },
    "tax_applies_to": {
      "type": "string",
      "enum": [
        "labor",
        "parts",
        "both",
        "none"
      ],
      "default": "both",
      "description": "Which totals tax applies to"
    },
    "tax_amount": {
      "type": "number",
      "description": "Tax amount"
    },
    "discount": {
      "type": "number",
      "description": "Discount value"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "$",
        "%"
      ],
      "description": "Discount type"
    },
    "grand_total": {
      "type": "number",
      "description": "Grand total"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "Estimate expiry date"
    },
    "estimate_date": {
      "type": "string",
      "format": "date",
      "description": "Editable estimate date shown on the document"
    },
    "ghost_items": {
      "type": "array",
      "description": "Remaining/ghost line items from a Ghost Mode split (split/phased billing)",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "part or labor"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "taxable": {
            "type": "boolean"
          }
        }
      }
    },
    "ghost_status": {
      "type": "string",
      "enum": [
        "none",
        "active",
        "converted"
      ],
      "default": "none",
      "description": "Ghost Mode state: none (no split), active (ghost exists), converted (ghost was converted to a new document)"
    },
    "ghost_converted_to": {
      "type": "string",
      "description": "ID of the new document created from this ghost"
    },
    "ghost_converted_type": {
      "type": "string",
      "description": "Invoice or RepairOrder"
    },
    "ghost_converted_number": {
      "type": "string",
      "description": "Number of the converted document"
    },
    "ghost_notes": {
      "type": "string",
      "description": "Editable 'What's Next' explanation shown on the ghost section"
    },
    "ghost_total": {
      "type": "number",
      "description": "Calculated total of remaining (ghost) items including tax"
    }
  },
  "required": [
    "customer_id",
    "vehicle_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
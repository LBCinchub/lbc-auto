{
  "name": "StaffAssistantAction",
  "type": "object",
  "properties": {
    "shop_owner_email": {
      "type": "string",
      "format": "email",
      "description": "Tenant key from the verified session"
    },
    "actor_user_id": {
      "type": "string",
      "description": "Staff member who requested the action"
    },
    "capability": {
      "type": "string",
      "description": "Assistant capability, e.g. estimates.create"
    },
    "kind": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "turn"
      ],
      "description": "turn = audit row for a read-only assistant turn"
    },
    "target_entity": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "target_version": {
      "type": "string",
      "description": "updated_date of the target at preview time"
    },
    "params": {
      "type": "object",
      "description": "Server-held action parameters; the browser never supplies them"
    },
    "params_sha256": {
      "type": "string"
    },
    "token_hash": {
      "type": "string",
      "description": "SHA-256 of the single-use confirmation token (token never stored)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "executing",
        "executed",
        "cancelled",
        "expired",
        "failed",
        "logged"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "green",
        "gray",
        "gray",
        "red",
        "gray"
      ],
      "default": "pending"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "tools_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result_summary": {
      "type": "string"
    },
    "result": {
      "type": "object",
      "description": "Receipt returned on success (replayed on a repeat confirm)"
    },
    "error_code": {
      "type": "string"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "shop_owner_email",
    "actor_user_id",
    "capability",
    "kind",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
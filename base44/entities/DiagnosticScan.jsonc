{
  "name": "DiagnosticScan",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Linked customer ID"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name for display"
    },
    "vehicle_id": {
      "type": "string",
      "description": "Linked vehicle ID"
    },
    "vehicle_info": {
      "type": "string",
      "description": "Vehicle display string"
    },
    "shop_owner_email": {
      "type": "string",
      "description": "Authenticated shop owner tenant"
    },
    "adapter_name": {
      "type": "string"
    },
    "mileage": {
      "type": "number"
    },
    "scan_timestamp": {
      "type": "string"
    },
    "freeze_frame": {
      "type": "object"
    },
    "readiness_monitors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "protocol_attempts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dtc_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "raw": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "live_data_snapshot": {
      "type": "object"
    },
    "ai_analysis": {
      "type": "object"
    },
    "ai_follow_up": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "customer_notes": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "content": {
                "type": "string"
              }
            }
          }
        },
        "saved_at": {
          "type": "string"
        }
      }
    },
    "codes_cleared": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Completed",
        "Codes Cleared",
        "Needs Follow-up"
      ],
      "default": "Completed"
    },
    "estimate_id": {
      "type": "string"
    },
    "repair_order_id": {
      "type": "string"
    }
  },
  "required": [
    "vehicle_id",
    "shop_owner_email"
  ],
  "rls": {
    "create": {
      "data.shop_owner_email": "{{user.email}}"
    },
    "read": {
      "data.shop_owner_email": "{{user.email}}"
    },
    "update": {
      "data.shop_owner_email": "{{user.email}}"
    },
    "delete": {
      "data.shop_owner_email": "{{user.email}}"
    }
  }
}
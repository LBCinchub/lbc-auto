{
  "name": "PaymentRecord",
  "type": "object",
  "properties": {
    "shop_owner_email": {
      "type": "string",
      "format": "email",
      "description": "Shop owner email \u2014 tenant scope key for cross-tenant isolation. Stamped on create from the authenticated session."
    },
    "mechanic_id": {
      "type": "string",
      "description": "Mechanic ID"
    },
    "mechanic_name": {
      "type": "string",
      "description": "Mechanic name for display"
    },
    "amount": {
      "type": "number",
      "description": "Payment amount in dollars"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Date of payment"
    },
    "period": {
      "type": "string",
      "description": "Pay period (e.g., 'Week of Apr 7-13')"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes about the payment"
    }
  },
  "required": [
    "mechanic_id",
    "amount",
    "payment_date"
  ],
  "rls": {
    "create": {
      "data.shop_owner_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.shop_owner_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.shop_owner_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.shop_owner_email": "{{user.email}}"
        }
      ]
    }
  }
}